# ShieldEscrow Environment Variables

# Google Gemini API Key (for AI Escrow Arbitrator & Verification Engine)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Authentication
JWT_SECRET=shield-escrow-jwt-secret-key-32chars-min

# Database (Optional - in-memory storage fallback is enabled automatically)
# MYSQL_URL=mysql://root:password@localhost:3306/shield_escrow

# Midnight Network Environment
MIDNIGHT_NETWORK=testnet-preprod
