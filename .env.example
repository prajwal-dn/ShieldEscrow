# ─────────────────────────────────────────────────────────────────
#  ShieldEscrow — Docker environment variables
#  Copy this file to .env and fill in real secrets before deploying.
#  This file is committed with safe defaults; .env is git-ignored.
# ─────────────────────────────────────────────────────────────────

# MariaDB
DB_ROOT_PASSWORD=rootSecret123
DB_NAME=shieldescrow
DB_USER=shielduser
DB_PASSWORD=Shield@1234

# ── Phase 3: Midnight Testnet ─────────────────────────────────────
# Contract address obtained after running `npm run deploy` in trustpay-midnight/
# Leave blank to run without on-chain verification (API-only mode)
MIDNIGHT_CONTRACT_ADDRESS=

# Midnight wallet seed (64-char hex) — used by trustpay-midnight CLI
# Generate by running `npm run deploy` and choosing option [1]
MIDNIGHT_WALLET_SEED=
